{
  "datasets": [
    {
      "name": "f51ad601",
      "displayName": "bronze_dq_issues_log",
      "queryLines": [
        "SELECT check_type\r\n",
        "    ,source_file\r\n",
        "    ,source_table\r\n",
        "    ,file_path\r\n",
        "    ,CAST(detected_at AS DATE) AS detected_at\r\n",
        "    ,COUNT(*) AS issues_detected\r\n",
        "FROM development.bronze.dq_issues_log\r\n",
        "GROUP BY check_type\r\n",
        "    ,source_file\r\n",
        "    ,source_table\r\n",
        "    ,file_path\r\n",
        "    ,CAST(detected_at AS DATE)\r\n",
        "ORDER BY CAST(detected_at AS DATE)\r\n",
        "    ,check_type"
      ]
    },
    {
      "name": "32908228",
      "displayName": "silver_dq_issues_log",
      "queryLines": [
        "SELECT check_type\r\n",
        "    ,source_file\r\n",
        "    ,source_table\r\n",
        "    ,file_path\r\n",
        "    ,CAST(detected_at AS DATE) AS detected_at\r\n",
        "    ,COUNT(*) AS issues_detected\r\n",
        "FROM development.silver.dq_issues_log\r\n",
        "GROUP BY check_type\r\n",
        "    ,source_file\r\n",
        "    ,source_table\r\n",
        "    ,file_path\r\n",
        "    ,CAST(detected_at AS DATE)\r\n",
        "ORDER BY CAST(detected_at AS DATE)\r\n",
        "    ,check_type"
      ]
    }
  ],
